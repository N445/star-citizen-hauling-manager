{% extends 'base.html.twig' %}

{% trans_default_domain 'account' %}

{% block title %}{{ 'login.title'|trans }} · Hauling Manager{% endblock %}

{% block body %}
    <div class="hm-auth">
        <div class="text-center mb-4">
            <h1 class="h3 mb-1">{{ 'login.title'|trans }}</h1>
            <p class="text-body-secondary mb-0">{{ 'login.subtitle'|trans }}</p>
        </div>

        <div class="card">
            <div class="card-body">
                {% if error %}
                    <div class="alert alert-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}">
                    <div class="mb-3">
                        <label class="form-label" for="username">{{ 'login.email'|trans }}</label>
                        <input class="form-control" type="email" id="username" name="_username" value="{{ lastUsername }}" autocomplete="email" required autofocus>
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="password">{{ 'login.password'|trans }}</label>
                        <input class="form-control" type="password" id="password" name="_password" autocomplete="current-password" required>
                    </div>
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                    <button class="btn btn-primary w-100" type="submit">{{ 'login.submit'|trans }}</button>
                </form>
            </div>
        </div>

        <p class="mt-3 text-center text-body-secondary">{{ 'login.no_account'|trans }} <a href="{{ path('app_register') }}">{{ 'login.register_link'|trans }}</a></p>
    </div>
{% endblock %}
