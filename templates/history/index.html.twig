{% extends 'base.html.twig' %}

{% trans_default_domain 'account' %}

{% block title %}{{ 'history.title'|trans }} · Hauling Manager{% endblock %}

{% block body %}
    {% import '_icons.html.twig' as icons %}
    <div class="hm-page-header">
        <h1 class="h3">{{ 'history.title'|trans }}</h1>
    </div>

    <div class="row g-3 mb-4">
        {% for label, value in {
            ('history.total.missions'|trans): missions|length,
            ('history.total.reward'|trans): 'history.reward'|trans({amount: totalReward}),
            ('history.total.duration'|trans): totalDuration|duration,
        } %}
            <div class="col-sm-4">
                <div class="hm-stat">
                    <div class="hm-eyebrow">{{ label }}</div>
                    <div class="hm-stat-value">{{ value }}</div>
                </div>
            </div>
        {% endfor %}
    </div>

    {% if missions is empty %}
        <div class="hm-empty">
            <div class="hm-empty-icon">{{ icons.icon('clock') }}</div>
            <p>{{ 'history.empty'|trans }}</p>
            <a class="btn btn-primary" href="{{ path('home') }}">{{ 'history.empty_cta'|trans }}</a>
        </div>
    {% else %}
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr class="hm-eyebrow">
                            <th>{{ 'history.column.tour'|trans }}</th>
                            <th>{{ 'history.column.mission'|trans }}</th>
                            <th>{{ 'history.column.type'|trans }}</th>
                            <th class="text-end">{{ 'history.column.reward'|trans }}</th>
                            <th>{{ 'history.column.finished_at'|trans }}</th>
                            <th class="text-end">{{ 'history.column.duration'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for mission in missions %}
                            <tr>
                                <td><a href="{{ path('tour', {id: mission.tour.id}) }}">{{ mission.tour.name }}</a></td>
                                <td>{{ mission.tour.missionLabel(mission) }}</td>
                                <td class="text-body-secondary">{{ mission.type.shortLabel|trans(domain: 'messages') }}</td>
                                <td class="text-end fw-semibold text-nowrap">{{ 'history.reward'|trans({amount: mission.reward}) }}</td>
                                <td class="text-nowrap">{{ 'history.finished_at'|trans({date: mission.finishedAt}) }}</td>
                                <td class="text-end text-nowrap">{{ mission.durationInSeconds is null ? '—' : mission.durationInSeconds|duration }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
