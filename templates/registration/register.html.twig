{% extends 'base.html.twig' %}

{% trans_default_domain 'account' %}
{% form_theme registrationForm _self %}

{% block form_errors %}
    {% for error in errors %}
        {% set translated = error.messageTemplate|trans(error.messageParameters, 'account') %}
        <div class="invalid-feedback d-block">{{ translated == error.messageTemplate ? error.message : translated }}</div>
    {% endfor %}
{% endblock %}

{% block title %}{{ 'registration.title'|trans }} · Hauling Manager{% endblock %}

{% block body %}
    <div class="hm-auth">
        <div class="text-center mb-4">
            <h1 class="h3 mb-1">{{ 'registration.title'|trans }}</h1>
            <p class="text-body-secondary mb-0">{{ 'registration.subtitle'|trans }}</p>
        </div>

        <div class="card">
            <div class="card-body">
                {{ form_start(registrationForm) }}
                    {{ form_rest(registrationForm) }}
                    <button class="btn btn-primary w-100 mt-2" type="submit">{{ 'registration.submit'|trans }}</button>
                {{ form_end(registrationForm) }}
            </div>
        </div>

        <p class="mt-3 text-center text-body-secondary">{{ 'registration.has_account'|trans }} <a href="{{ path('app_login') }}">{{ 'registration.login_link'|trans }}</a></p>
    </div>
{% endblock %}
