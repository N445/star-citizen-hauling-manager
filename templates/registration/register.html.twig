{% extends 'base.html.twig' %}

{% trans_default_domain 'account' %}
{% form_theme registrationForm _self %}

{% block form_errors %}
    {% for error in errors %}
        {% set translated = error.messageTemplate|trans(error.messageParameters, 'account') %}
        <div class="invalid-feedback d-block">{{ translated == error.messageTemplate ? error.message : translated }}</div>
    {% endfor %}
{% endblock %}

{% block title %}{{ 'registration.title'|trans }} · Hauling Manager{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-sm-8 col-md-6 col-lg-4">
            <h1 class="h3 mb-3">{{ 'registration.title'|trans }}</h1>

            {{ form_start(registrationForm) }}
                {{ form_rest(registrationForm) }}
                <button class="btn btn-primary w-100" type="submit">{{ 'registration.submit'|trans }}</button>
            {{ form_end(registrationForm) }}

            <p class="mt-3 text-body-secondary">{{ 'registration.has_account'|trans }} <a href="{{ path('app_login') }}">{{ 'registration.login_link'|trans }}</a></p>
        </div>
    </div>
{% endblock %}
