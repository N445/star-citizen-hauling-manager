{% import '_icons.html.twig' as icons -%}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-bs-theme="light">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="light dark">
        <title>{% block title %}Hauling Manager{% endblock %}</title>
        <script>
            (() => {
                let choice = 'auto';
                try { choice = localStorage.getItem('hm-theme') || 'auto'; } catch (e) {}
                if (!['light', 'dark', 'auto'].includes(choice)) choice = 'auto';
                const dark = choice === 'dark' || (choice === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
                document.documentElement.dataset.themeChoice = choice;
                document.documentElement.dataset.bsTheme = dark ? 'dark' : 'light';
            })();
        </script>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2218%22 fill=%22%230b1118%22/><rect x=%2220%22 y=%2230%22 width=%2260%22 height=%2240%22 fill=%22%2339d98a%22/></svg>">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body data-controller="highlight">
        <a class="visually-hidden-focusable hm-skip-link" href="#main">{{ 'nav.skip'|trans }}</a>
        <nav class="navbar navbar-expand hm-navbar sticky-md-top mb-4" aria-label="{{ 'nav.main'|trans }}">
            <div class="{{ block('main_class') }} flex-wrap gap-2">
                <a class="navbar-brand hm-brand" href="{{ path('home') }}">
                    <span class="hm-brand-mark">{{ icons.icon('brand') }}</span>
                    <span>Hauling <span class="hm-brand-accent">Manager</span></span>
                </a>
                <div class="d-flex align-items-center flex-wrap gap-2 ms-auto">
                    {{ include('_user_menu.html.twig', ignore_missing = true) }}
                    <div class="btn-group btn-group-sm" role="group" aria-label="{{ 'nav.language'|trans }}">
                        {% for locale in app.enabled_locales %}
                            {% set current = locale == app.request.locale %}
                            <a class="btn btn-outline-secondary{{ current ? ' active' }}" href="{{ path('locale_switch', {locale: locale}) }}" hreflang="{{ locale }}" lang="{{ locale }}"{% if current %} aria-current="true"{% endif %}>{{ locale|upper }}</a>
                        {% endfor %}
                    </div>
                    <div class="dropdown" data-controller="theme">
                        <button class="btn btn-sm btn-outline-secondary hm-icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'nav.theme.label'|trans }}" title="{{ 'nav.theme.label'|trans }}">
                            {{ icons.icon('sun', 'hm-theme-icon hm-theme-icon--light') }}
                            {{ icons.icon('moon', 'hm-theme-icon hm-theme-icon--dark') }}
                            {{ icons.icon('auto', 'hm-theme-icon hm-theme-icon--auto') }}
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end hm-theme-menu" role="menu">
                            {% for choice, icon in {light: 'sun', dark: 'moon', auto: 'auto'} %}
                                <li>
                                    <button class="dropdown-item d-flex align-items-center gap-2" type="button" role="menuitemradio" aria-checked="false" data-theme-option="{{ choice }}" data-theme-target="option" data-action="theme#choose" data-theme-choice-param="{{ choice }}">
                                        {{ icons.icon(icon) }}
                                        <span class="flex-grow-1">{{ ('nav.theme.' ~ choice)|trans }}</span>
                                        {{ icons.icon('check', 'hm-theme-check') }}
                                    </button>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <div class="toast-container hm-toasts" data-controller="toaster" aria-live="polite" aria-atomic="false">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    {{ include('_toast.html.twig', {type: type, message: message|trans}) }}
                {% endfor %}
            {% endfor %}
            <template data-toaster-target="template">
                {{ include('_toast.html.twig', {type: 'info', message: ''}) }}
            </template>
        </div>

        <main id="main" class="{% block main_class %}container{% endblock %} hm-main pb-5" tabindex="-1">
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
