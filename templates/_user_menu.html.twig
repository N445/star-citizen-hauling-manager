{% trans_default_domain 'account' %}
<ul class="navbar-nav flex-row align-items-center gap-3 ms-auto">
    {% if app.user %}
        <li class="nav-item"><a class="nav-link" href="{{ path('tour_index') }}">{{ 'menu.tours'|trans }}</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ path('history') }}">{{ 'menu.history'|trans }}</a></li>
        <li class="nav-item d-none d-md-block"><a class="nav-link" href="{{ path('profile') }}" title="{{ 'menu.profile'|trans }}">{{ app.user.email }}</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ path('app_logout') }}">{{ 'menu.logout'|trans }}</a></li>
    {% else %}
        <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}">{{ 'menu.login'|trans }}</a></li>
        <li class="nav-item"><a class="btn btn-outline-light btn-sm" href="{{ path('app_register') }}">{{ 'menu.register'|trans }}</a></li>
    {% endif %}
</ul>
