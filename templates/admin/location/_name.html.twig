{% set location = entity.instance %}
{% set path = location.path %}
{% set depth = path|length - 1 %}
<div class="location-node d-flex align-items-center gap-2" style="padding-left: {{ depth * 1.75 }}rem">
    {% if depth > 0 %}<span class="text-body-secondary" aria-hidden="true">└</span>{% endif %}
    <i class="fa {{ location.children is empty ? 'fa-location-dot' : (depth == 0 ? 'fa-globe' : 'fa-folder-open') }} text-body-secondary" aria-hidden="true"></i>
    <span class="{{ depth == 0 ? 'fw-bold' }}">{{ location.name }}</span>
    {% if app.request.query.get('query') and depth > 0 %}
        <small class="text-body-secondary">{{ path|slice(0, -1)|map(l => l.name)|join(' › ') }}</small>
    {% endif %}
</div>
