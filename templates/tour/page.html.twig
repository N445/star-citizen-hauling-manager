{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}{{ tour ? tour.name : 'tour.new'|trans }} — {{ parent() }}{% endblock %}

{% block main_class %}container-fluid px-3 px-md-4{% endblock %}

{% block body %}
    {% set startTab = tour and tour.missions is not empty ? 'route' : 'missions' %}
    <div class="row g-3 g-xl-4 tour-page" data-controller="tour-tabs" data-tour-tabs-initial-value="{{ startTab }}" data-tour-tabs-key-value="{{ tour ? tour.id : 'new' }}" data-tab="{{ startTab }}">
        <section class="col-xl-3 tour-pane" id="tour-pane-missions" role="tabpanel" aria-labelledby="tour-tab-missions" data-tour-tabs-target="pane" data-pane="missions">
            {% set editing = not tour or tourForm.vars.submitted %}
            <div class="card mb-3 tour-card" data-controller="tour-card" data-tour-card-editing-value="{{ editing ? 'true' : 'false' }}">
                <div class="card-header d-flex justify-content-between align-items-center gap-2">
                    <span class="d-flex align-items-center gap-2 min-w-0">
                        <span class="step-badge {{ tour ? 'step-badge--done' }}" aria-hidden="true">1</span>
                        <span class="text-truncate">{{ (tour ? 'tour.card.title' : 'tour.new')|trans }}</span>
                    </span>
                    {% if tour %}
                        <span class="d-flex align-items-center gap-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary tour-card__edit" data-tour-card-target="editButton" data-action="tour-card#edit"
                                    title="{{ 'tour.summary.edit'|trans }}" aria-label="{{ 'tour.summary.edit'|trans }}"{% if editing %} hidden{% endif %}>{{ icons.icon('pencil') }}</button>
                            <a class="btn btn-sm btn-outline-primary" href="{{ path('tour_new') }}"
                               {% if not app.user %}title="{{ 'tour.guest.replace_hint'|trans }}"{% endif %}>{{ 'tour.new'|trans }}</a>
                        </span>
                    {% endif %}
                </div>
                {% if not app.user %}
                    <div class="small text-body-secondary px-3 pt-2">{{ (tour ? 'tour.guest.replace_hint' : 'tour.guest.account_hint')|trans }}</div>
                {% endif %}
                <div class="card-body">
                    {% if tour %}
                        <div class="tour-summary" data-tour-card-target="summary"{% if editing %} hidden{% endif %}>
                            <h2 class="tour-summary__name">{{ tour.name }}</h2>
                            <dl class="tour-summary__list">
                                <dt>{{ 'tour.form.ship'|trans }}</dt>
                                <dd>
                                    {{ tour.shipName }}
                                    {% if tour.ship %}<span class="text-body-secondary">· {{ tour.ship.manufacturer }}</span>{% else %}<div class="small text-body-secondary">{{ 'tour.summary.off_catalogue'|trans }}</div>{% endif %}
                                </dd>
                                <dt>{{ 'tour.summary.capacity'|trans }}</dt>
                                <dd><strong>{{ tour.capacity }}</strong> SCU</dd>
                                <dt>{{ 'tour.form.start_location'|trans }}</dt>
                                <dd>{{ tour.startLocation ?: 'tour.summary.no_start'|trans }}</dd>
                                {% if tour.ship %}
                                    <dt>{{ 'tour.summary.doors'|trans }}</dt>
                                    <dd class="d-flex flex-wrap gap-1">
                                        {% for door in tour.doorSides %}
                                            <span class="badge tour-summary__door">{{ door.label|trans }}</span>
                                        {% endfor %}
                                        {% if tour.hasDoorOverride %}<span class="small text-body-secondary">{{ 'tour.summary.doors_custom'|trans }}</span>{% endif %}
                                    </dd>
                                {% endif %}
                            </dl>
                        </div>
                    {% endif %}
                    <div data-tour-card-target="form"{% if not editing %} hidden{% endif %}>
                        {% if not tour %}
                            <p class="tour-start-hint">{{ 'tour.start_hint'|trans }}</p>
                        {% endif %}
                        {{ form_start(tourForm, {attr: {novalidate: 'novalidate', 'data-action': 'change->tour-card#dirty input->tour-card#dirty'}}) }}
                            {{ form_errors(tourForm) }}
                            {{ form_row(tourForm.name) }}
                            <div data-controller="ship-capacity door-sides">
                                {{ form_row(tourForm.shipName) }}
                                {{ form_row(tourForm.capacity) }}
                                {{ form_row(tourForm.doorSides) }}
                            </div>
                            {{ form_row(tourForm.startLocation) }}
                            <div class="d-flex gap-2">
                                <button class="btn btn-primary flex-grow-1" data-track="{{ tour ? 'tour-save' : 'tour-create' }}">{{ (tour ? 'tour.form.save' : 'tour.form.create')|trans }}</button>
                                {% if tour %}
                                    <button type="button" class="btn btn-outline-secondary" data-action="tour-card#cancel">{{ 'action.cancel'|trans }}</button>
                                {% endif %}
                            </div>
                        {{ form_end(tourForm) }}
                    </div>
                </div>
            </div>

            {% if tour %}
                {{ component('MissionBoard', {tour: tour}) }}
            {% endif %}
        </section>

        <section class="col-xl-6 tour-pane" id="tour-pane-cargo" role="tabpanel" aria-labelledby="tour-tab-cargo" data-tour-tabs-target="pane" data-pane="cargo">
            <div class="card sticky-xl-top cargo-panel"
                 data-controller="cargo-grid"
                 data-cargo-grid-groups-value="{{ (ship ? ship.cargoGroups : [])|json_encode }}"
                 data-cargo-grid-labels-value="{{ {canvas: 'cargo.canvas_label'|trans, onBoard: 'cargo.legend.onBoard'|trans, toLoad: 'cargo.legend.toLoad'|trans, toUnload: 'cargo.legend.toUnload'|trans, stacked: 'cargo.tooltip.stacked'|trans, problems: {outside: 'cargo.edit.error.outside'|trans, shape: 'cargo.edit.error.shape'|trans, size: 'cargo.edit.error.size'|trans, overlap: 'cargo.edit.error.overlap'|trans, unsupported: 'cargo.edit.error.unsupported'|trans, supports: 'cargo.edit.error.supports'|trans}}|json_encode }}"
                 data-action="tom-select:change@window->cargo-grid#show cargo:plan@window->cargo-grid#plan cargo:highlight@window->cargo-grid#highlight cargo:doors@window->cargo-grid#doors cargo:rejected@window->cargo-grid#rejected">
                <div class="card-header d-flex justify-content-between align-items-center gap-2">
                    <span>{{ 'cargo.title'|trans }} <small class="text-body-secondary">— {{ 'cargo.scale'|trans }}</small></span>
                    <ul class="cargo-legend" data-cargo-grid-target="legend" aria-label="{{ 'cargo.legend.aria'|trans }}"{% if not ship or ship.cargoGroups is empty %} hidden{% endif %}>
                        {% for kind in ['onBoard', 'toLoad', 'toUnload', 'stacked'] %}
                            <li class="cargo-legend__item cargo-legend__item--{{ kind }}" data-legend-item>
                                <span class="cargo-legend__swatch" aria-hidden="true"></span>
                                {{ ('cargo.legend.' ~ kind)|trans }}
                                <span class="cargo-legend__count"><span data-cargo-grid-target="count" data-kind="{{ kind }}">0</span>{% if kind != 'stacked' %}&nbsp;SCU{% endif %}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="card-body cargo-body">
                    <div class="cargo-stage" data-cargo-grid-target="stage" tabindex="0" aria-describedby="cargo-edit-help"{% if not ship or ship.cargoGroups is empty %} hidden{% endif %}>
                        <div data-cargo-grid-target="canvas"></div>
                        <div class="cargo-tooltip" data-cargo-grid-target="tooltip" role="tooltip" hidden></div>
                        <div class="cargo-toolbar" role="toolbar" aria-label="{{ 'cargo.edit.toolbar'|trans }}">
                            <button type="button" class="btn btn-sm cargo-tool" data-cargo-grid-target="undo" data-action="cargo-grid#undo" title="{{ 'cargo.edit.undo_hint'|trans }}" disabled>↶ {{ 'cargo.edit.undo'|trans }}</button>
                            <button type="button" class="btn btn-sm cargo-tool" data-cargo-grid-target="resetAll" data-action="cargo-grid#resetPlacement" title="{{ 'cargo.edit.reset_all_hint'|trans }}" disabled>↺ {{ 'cargo.edit.reset_all'|trans }}</button>
                            <span class="cargo-badge" data-placed-badge hidden title="{{ 'cargo.edit.placed_count_hint'|trans }}">✓ <span data-cargo-grid-target="placedCount">0/0</span> {{ 'cargo.edit.placed_count'|trans }}</span>
                            <button type="button" class="btn btn-sm cargo-tool cargo-tool--lock" data-cargo-grid-target="lock" data-action="cargo-grid#unlock" hidden>🔒 {{ 'cargo.edit.locked'|trans }}</button>
                        </div>
                        <div class="cargo-actions" data-cargo-grid-target="actions" role="group" aria-label="{{ 'cargo.edit.actions'|trans }}" hidden>
                            <button type="button" class="btn btn-sm cargo-action cargo-action--placed" data-cargo-grid-target="placed" data-action="cargo-grid#togglePlaced" aria-pressed="false" title="{{ 'cargo.edit.placed_hint'|trans }}">✓ {{ 'cargo.edit.placed'|trans }}</button>
                            <button type="button" class="btn btn-sm cargo-action" data-cargo-grid-target="rotate" data-action="cargo-grid#rotate" title="{{ 'cargo.edit.rotate_hint'|trans }}" disabled>⟳ {{ 'cargo.edit.rotate'|trans }}</button>
                            <button type="button" class="btn btn-sm cargo-action" data-cargo-grid-target="resetMission" data-action="cargo-grid#resetMission" title="{{ 'cargo.edit.reset_mission_hint'|trans }}" disabled>↺ {{ 'cargo.edit.reset_mission'|trans }}</button>
                        </div>
                        <p class="cargo-notice" data-cargo-grid-target="notice" role="status" aria-live="polite" hidden></p>
                        <button type="button" class="btn btn-sm cargo-stage__reset" data-cargo-grid-target="reset" data-action="cargo-grid#resetView" data-track="cargo-reset-view"
                                title="{{ 'cargo.reset_view'|trans }}" aria-label="{{ 'cargo.reset_view'|trans }}">
                            <svg class="hm-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M1.5 1a.5.5 0 0 0-.5.5v4a.5.5 0 0 1-1 0v-4A1.5 1.5 0 0 1 1.5 0h4a.5.5 0 0 1 0 1zM10 .5a.5.5 0 0 1 .5-.5h4A1.5 1.5 0 0 1 16 1.5v4a.5.5 0 0 1-1 0v-4a.5.5 0 0 0-.5-.5h-4a.5.5 0 0 1-.5-.5M.5 10a.5.5 0 0 1 .5.5v4a.5.5 0 0 0 .5.5h4a.5.5 0 0 1 0 1h-4A1.5 1.5 0 0 1 0 14.5v-4a.5.5 0 0 1 .5-.5m15 0a.5.5 0 0 1 .5.5v4a1.5 1.5 0 0 1-1.5 1.5h-4a.5.5 0 0 1 0-1h4a.5.5 0 0 0 .5-.5v-4a.5.5 0 0 1 .5-.5M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5"/></svg>
                        </button>
                        <p class="cargo-stage__hint" id="cargo-edit-help"><span class="cargo-stage__hint-mouse">{{ 'cargo.controls'|trans }}</span><span class="cargo-stage__hint-touch">{{ 'cargo.controls_touch'|trans }}</span></p>
                    </div>
                    <div class="cargo-empty" data-cargo-grid-target="empty"{% if ship and ship.cargoGroups is not empty %} hidden{% endif %}>
                        <svg class="cargo-empty__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M1.5 4.5 8 1l6.5 3.5v7L8 15l-6.5-3.5z" fill="none" stroke="currentColor" stroke-width=".8" stroke-linejoin="round"/><path d="M1.5 4.5 8 8l6.5-3.5M8 8v7" fill="none" stroke="currentColor" stroke-width=".8" stroke-linejoin="round"/><path d="M4.75 2.75 11.25 6.25" fill="none" stroke="currentColor" stroke-width=".8"/></svg>
                        <p class="cargo-empty__title">{{ 'cargo.empty_title'|trans }}</p>
                        <p class="cargo-empty__text">{{ 'cargo.no_grid'|trans }}</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="col-xl-3 tour-pane" id="tour-pane-route" role="tabpanel" aria-labelledby="tour-tab-route" data-tour-tabs-target="pane" data-pane="route">
            {% if tour %}
                {{ component('RoutePanel', {tour: tour}) }}
            {% else %}
                <div class="card">
                    <div class="card-header d-flex align-items-center gap-2"><span class="step-badge" aria-hidden="true">3</span>{{ 'route.title'|trans }}</div>
                    <div class="card-body">
                        <div class="hm-empty">
                            <strong>{{ 'route.create_tour_first'|trans }}</strong>
                            <div class="small text-body-secondary">{{ 'tour.next_steps'|trans }}</div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </section>

        <nav class="tour-tabs" role="tablist" aria-label="{{ 'tour.tabs.aria'|trans }}">
            {% for pane, icon in {missions: 'list', route: 'pin', cargo: 'brand'} %}
                <button type="button" class="tour-tabs__tab" role="tab" id="tour-tab-{{ pane }}" data-track="tour-tab" data-track-props='{"pane":"{{ pane }}"}' aria-selected="{{ pane == startTab ? 'true' : 'false' }}" aria-controls="tour-pane-{{ pane }}"
                        data-tour-tabs-target="tab" data-pane="{{ pane }}" data-action="tour-tabs#show" data-tour-tabs-pane-param="{{ pane }}">
                    {{ icons.icon(icon) }}<span>{{ ('tour.tabs.' ~ pane)|trans }}</span>
                </button>
            {% endfor %}
        </nav>
    </div>
{% endblock %}