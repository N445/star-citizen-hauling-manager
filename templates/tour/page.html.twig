{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}{{ tour ? tour.name : 'tour.new'|trans }} — {{ parent() }}{% endblock %}

{% block main_class %}container-fluid px-4{% endblock %}

{% block body %}
    <div class="row g-4 tour-page">
        <section class="col-lg-3">
            {% set editing = not tour or tourForm.vars.submitted %}
            <div class="card mb-3 tour-card" data-controller="tour-card" data-tour-card-editing-value="{{ editing ? 'true' : 'false' }}">
                <div class="card-header d-flex justify-content-between align-items-center gap-2">
                    <span class="d-flex align-items-center gap-2 min-w-0">
                        <span class="step-badge {{ tour ? 'step-badge--done' }}" aria-hidden="true">1</span>
                        <span class="text-truncate">{{ (tour ? 'tour.card.title' : 'tour.new')|trans }}</span>
                    </span>
                    {% if tour %}
                        <span class="d-flex align-items-center gap-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary tour-card__edit" data-tour-card-target="editButton" data-action="tour-card#edit"
                                    title="{{ 'tour.summary.edit'|trans }}" aria-label="{{ 'tour.summary.edit'|trans }}"{% if editing %} hidden{% endif %}>{{ icons.icon('pencil') }}</button>
                            <a class="btn btn-sm btn-outline-primary" href="{{ path('tour_new') }}"
                               {% if not app.user %}title="{{ 'tour.guest.replace_hint'|trans }}"{% endif %}>{{ 'tour.new'|trans }}</a>
                        </span>
                    {% endif %}
                </div>
                {% if not app.user %}
                    <div class="small text-body-secondary px-3 pt-2">{{ (tour ? 'tour.guest.replace_hint' : 'tour.guest.account_hint')|trans }}</div>
                {% endif %}
                <div class="card-body">
                    {% if tour %}
                        <div class="tour-summary" data-tour-card-target="summary"{% if editing %} hidden{% endif %}>
                            <h2 class="tour-summary__name">{{ tour.name }}</h2>
                            <dl class="tour-summary__list">
                                <dt>{{ 'tour.form.ship'|trans }}</dt>
                                <dd>
                                    {{ tour.shipName }}
                                    {% if tour.ship %}<span class="text-body-secondary">· {{ tour.ship.manufacturer }}</span>{% else %}<div class="small text-body-secondary">{{ 'tour.summary.off_catalogue'|trans }}</div>{% endif %}
                                </dd>
                                <dt>{{ 'tour.summary.capacity'|trans }}</dt>
                                <dd><strong>{{ tour.capacity }}</strong> SCU</dd>
                                <dt>{{ 'tour.form.start_location'|trans }}</dt>
                                <dd>{{ tour.startLocation ?: 'tour.summary.no_start'|trans }}</dd>
                                {% if tour.ship %}
                                    <dt>{{ 'tour.summary.doors'|trans }}</dt>
                                    <dd class="d-flex flex-wrap gap-1">
                                        {% for door in tour.ship.doorSides %}
                                            <span class="badge tour-summary__door">{{ door.label|trans }}</span>
                                        {% endfor %}
                                    </dd>
                                {% endif %}
                            </dl>
                        </div>
                    {% endif %}
                    <div data-tour-card-target="form"{% if not editing %} hidden{% endif %}>
                        {% if not tour %}
                            <p class="tour-start-hint">{{ 'tour.start_hint'|trans }}</p>
                        {% endif %}
                        {{ form_start(tourForm, {attr: {novalidate: 'novalidate', 'data-action': 'change->tour-card#dirty input->tour-card#dirty'}}) }}
                            {{ form_errors(tourForm) }}
                            {{ form_row(tourForm.name) }}
                            <div data-controller="ship-capacity door-sides">
                                {{ form_row(tourForm.shipName) }}
                                {{ form_row(tourForm.capacity) }}
                                {{ form_row(tourForm.doorSides) }}
                            </div>
                            {{ form_row(tourForm.startLocation) }}
                            <div class="d-flex gap-2">
                                <button class="btn btn-primary flex-grow-1">{{ (tour ? 'tour.form.save' : 'tour.form.create')|trans }}</button>
                                {% if tour %}
                                    <button type="button" class="btn btn-outline-secondary" data-action="tour-card#cancel">{{ 'action.cancel'|trans }}</button>
                                {% endif %}
                            </div>
                        {{ form_end(tourForm) }}
                    </div>
                </div>
            </div>

            {% if tour %}
                {{ component('MissionBoard', {tour: tour}) }}
            {% endif %}
        </section>

        <section class="col-lg-6">
            <div class="card sticky-lg-top cargo-panel"
                 data-controller="cargo-grid"
                 data-cargo-grid-groups-value="{{ (ship ? ship.cargoGroups : [])|json_encode }}"
                 data-cargo-grid-labels-value="{{ {canvas: 'cargo.canvas_label'|trans, onBoard: 'cargo.legend.onBoard'|trans, toLoad: 'cargo.legend.toLoad'|trans, toUnload: 'cargo.legend.toUnload'|trans, stacked: 'cargo.tooltip.stacked'|trans}|json_encode }}"
                 data-action="tom-select:change@window->cargo-grid#show cargo:plan@window->cargo-grid#plan cargo:highlight@window->cargo-grid#highlight cargo:doors@window->cargo-grid#doors">
                <div class="card-header d-flex justify-content-between align-items-center gap-2">
                    <span>{{ 'cargo.title'|trans }} <small class="text-body-secondary">— {{ 'cargo.scale'|trans }}</small></span>
                    <ul class="cargo-legend" data-cargo-grid-target="legend" aria-label="{{ 'cargo.legend.aria'|trans }}"{% if not ship or ship.cargoGroups is empty %} hidden{% endif %}>
                        {% for kind in ['onBoard', 'toLoad', 'toUnload', 'stacked'] %}
                            <li class="cargo-legend__item cargo-legend__item--{{ kind }}" data-legend-item>
                                <span class="cargo-legend__swatch" aria-hidden="true"></span>
                                {{ ('cargo.legend.' ~ kind)|trans }}
                                <span class="cargo-legend__count"><span data-cargo-grid-target="count" data-kind="{{ kind }}">0</span>{% if kind != 'stacked' %}&nbsp;SCU{% endif %}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="card-body cargo-body">
                    <div class="cargo-stage" data-cargo-grid-target="stage"{% if not ship or ship.cargoGroups is empty %} hidden{% endif %}>
                        <div data-cargo-grid-target="canvas"></div>
                        <div class="cargo-tooltip" data-cargo-grid-target="tooltip" role="tooltip" hidden></div>
                        <button type="button" class="btn btn-sm cargo-stage__reset" data-cargo-grid-target="reset" data-action="cargo-grid#resetView"
                                title="{{ 'cargo.reset_view'|trans }}" aria-label="{{ 'cargo.reset_view'|trans }}">
                            <svg class="hm-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M1.5 1a.5.5 0 0 0-.5.5v4a.5.5 0 0 1-1 0v-4A1.5 1.5 0 0 1 1.5 0h4a.5.5 0 0 1 0 1zM10 .5a.5.5 0 0 1 .5-.5h4A1.5 1.5 0 0 1 16 1.5v4a.5.5 0 0 1-1 0v-4a.5.5 0 0 0-.5-.5h-4a.5.5 0 0 1-.5-.5M.5 10a.5.5 0 0 1 .5.5v4a.5.5 0 0 0 .5.5h4a.5.5 0 0 1 0 1h-4A1.5 1.5 0 0 1 0 14.5v-4a.5.5 0 0 1 .5-.5m15 0a.5.5 0 0 1 .5.5v4a1.5 1.5 0 0 1-1.5 1.5h-4a.5.5 0 0 1 0-1h4a.5.5 0 0 0 .5-.5v-4a.5.5 0 0 1 .5-.5M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5"/></svg>
                        </button>
                        <p class="cargo-stage__hint">{{ 'cargo.controls'|trans }}</p>
                    </div>
                    <div class="cargo-empty" data-cargo-grid-target="empty"{% if ship and ship.cargoGroups is not empty %} hidden{% endif %}>
                        <svg class="cargo-empty__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M1.5 4.5 8 1l6.5 3.5v7L8 15l-6.5-3.5z" fill="none" stroke="currentColor" stroke-width=".8" stroke-linejoin="round"/><path d="M1.5 4.5 8 8l6.5-3.5M8 8v7" fill="none" stroke="currentColor" stroke-width=".8" stroke-linejoin="round"/><path d="M4.75 2.75 11.25 6.25" fill="none" stroke="currentColor" stroke-width=".8"/></svg>
                        <p class="cargo-empty__title">{{ 'cargo.empty_title'|trans }}</p>
                        <p class="cargo-empty__text">{{ 'cargo.no_grid'|trans }}</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="col-lg-3">
            {% if tour %}
                {{ component('RoutePanel', {tour: tour}) }}
            {% else %}
                <div class="card">
                    <div class="card-header d-flex align-items-center gap-2"><span class="step-badge" aria-hidden="true">3</span>{{ 'route.title'|trans }}</div>
                    <div class="card-body">
                        <div class="hm-empty">
                            <strong>{{ 'route.create_tour_first'|trans }}</strong>
                            <div class="small text-body-secondary">{{ 'tour.next_steps'|trans }}</div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}
