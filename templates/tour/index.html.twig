{% extends 'base.html.twig' %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">{{ 'tour.list.title'|trans }}</h1>
        <a class="btn btn-primary" href="{{ path('tour_new') }}">{{ 'tour.new'|trans }}</a>
    </div>

    {% if tours is empty %}
        <p class="text-body-secondary">{{ 'tour.list.empty'|trans }}</p>
    {% else %}
        <div class="list-group">
            {% for tour in tours %}
                <a class="list-group-item list-group-item-action d-flex justify-content-between" href="{{ path('tour', {id: tour.id}) }}">
                    <span>{{ tour.name }} <small class="text-body-secondary">— {{ tour.shipName }}</small></span>
                    <span>{{ 'tour.list.summary'|trans({count: tour.missions|length, reward: tour.totalReward}) }}</span>
                </a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
