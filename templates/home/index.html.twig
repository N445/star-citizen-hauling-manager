{% extends 'base.html.twig' %}

{% block title %}Hauling Manager{% endblock %}

{% block body %}
    <header class="topbar">
        <h1>Hauling <span>Manager</span></h1>
        <p>Tour de pickup / drop par mission, soute visualisée.</p>
    </header>
    <script type="application/json" id="sch-catalog">{{ catalog|raw }}</script>
    <main class="layout" data-controller="planner-storage">
        <div class="planner-col">
            <twig:HaulingPlanner />
        </div>
        <div class="results">
            <twig:RouteStepper />
        </div>
    </main>
{% endblock %}
