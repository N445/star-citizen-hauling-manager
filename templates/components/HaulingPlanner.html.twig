{% macro pick(model, source, value, text, empty) %}
    <select data-controller="tom-select" data-tom-select-source-value="{{ source }}" data-tom-select-current-value="{{ value }}"{% if empty %} data-tom-select-empty-value="{{ empty }}"{% endif %} data-model="norender|on(change)|{{ model }}">
        <option value="{{ value }}" selected>{{ text }}</option>
    </select>
{% endmacro %}
{% import _self as f %}
<div {{ attributes }}>
    <section class="panel">
        <h2>Vaisseau &amp; départ</h2>
        <div class="row">
            <label>Vaisseau
                {{ f.pick('ship', 'ships', ship, this.shipLabel) }}
            </label>
            <label>Lieu de départ
                {{ f.pick('start', 'locations', start, this.locationName(start)) }}
            </label>
        </div>
    </section>

    <section class="panel">
        <h2>Missions</h2>
        {% for m, mission in missions %}
            {% set type = mission.type %}
            <div class="mission" id="mission-{{ mission.uid }}" data-testid="mission" data-type="{{ type }}">
                <div class="mission-head">
                    <label>Libellé
                        <input type="text" maxlength="80" data-model="norender|on(change)|missions[{{ m }}][label]" placeholder="Mission {{ m + 1 }}">
                    </label>
                    <label style="max-width:110px">Prime (aUEC){% if type == 'freeShopping' %} <span class="muted">facultatif</span>{% endif %}
                        <input type="number" min="0" data-model="norender|on(change)|missions[{{ m }}][reward]">
                    </label>
                    <button type="button" class="danger small" data-action="live#action" data-live-action-param="removeMission" data-live-index-param="{{ m }}" aria-label="Supprimer la mission">&times;</button>
                </div>
                <div class="row mission-type">
                    <label>Type de mission
                        <select data-controller="tom-select" data-tom-select-source-value="types" data-tom-select-current-value="{{ type }}" data-testid="mission-type" data-model="on(change)|missions[{{ m }}][type]">
                            <option value="{{ type }}" selected>{{ this.typeLabel(type) }}</option>
                        </select>
                    </label>
                    <label>Taille max de caisse
                        <select data-controller="tom-select" data-tom-select-source-value="sizes" data-tom-select-current-value="{{ mission.maxSize }}" data-model="norender|on(change)|missions[{{ m }}][maxSize]">
                            <option value="{{ mission.maxSize }}" selected>{{ mission.maxSize }} SCU</option>
                        </select>
                    </label>
                </div>
                {% if type == 'direct' or type == 'multipleDropOff' %}
                    <div class="row shared">
                        <label>Pickup
                            {{ f.pick('missions[' ~ m ~ '][pickup]', 'locations', mission.pickup, this.locationName(mission.pickup)) }}
                        </label>
                        {% if type == 'direct' %}
                            <label>Drop
                                {{ f.pick('missions[' ~ m ~ '][dropoff]', 'locations', mission.dropoff, this.locationName(mission.dropoff)) }}
                            </label>
                        {% endif %}
                    </div>
                {% elseif type == 'multiplePickUp' %}
                    <div class="row shared">
                        <label>Drop
                            {{ f.pick('missions[' ~ m ~ '][dropoff]', 'locations', mission.dropoff, this.locationName(mission.dropoff)) }}
                        </label>
                    </div>
                {% else %}
                    <div class="row shared">
                        <label>Destination <span class="muted">facultatif</span>
                            {{ f.pick('missions[' ~ m ~ '][dropoff]', 'locations', mission.dropoff, mission.dropoff ? this.locationName(mission.dropoff) : 'Aucune', 'Aucune') }}
                        </label>
                    </div>
                {% endif %}
                {% for l, lot in mission.lots %}
                    <div class="lot" id="lot-{{ lot.uid }}" data-type="{{ type }}">
                        <div class="row-3">
                            {% if type == 'multipleDropOff' %}
                                <label>Drop
                                    {{ f.pick('missions[' ~ m ~ '][lots][' ~ l ~ '][dropoff]', 'locations', lot.dropoff, this.locationName(lot.dropoff)) }}
                                </label>
                            {% elseif type == 'multiplePickUp' or type == 'freeShopping' %}
                                <label>{{ type == 'freeShopping' ? "Lieu d'achat" : 'Pickup' }}
                                    {{ f.pick('missions[' ~ m ~ '][lots][' ~ l ~ '][pickup]', 'locations', lot.pickup, this.locationName(lot.pickup)) }}
                                </label>
                            {% endif %}
                            <label>Ressource
                                <select data-controller="tom-select" data-tom-select-source-value="resources" data-tom-select-create-value="true" data-tom-select-current-value="{{ lot.resource }}" data-model="norender|on(change)|missions[{{ m }}][lots][{{ l }}][resource]">
                                    <option value="{{ lot.resource }}" selected>{{ lot.resource }}</option>
                                </select>
                            </label>
                            <label>SCU
                                <input type="number" min="1" data-model="norender|on(change)|missions[{{ m }}][lots][{{ l }}][scu]">
                            </label>
                        </div>
                        <button type="button" class="danger small" data-action="live#action" data-live-action-param="removeLot" data-live-mission-param="{{ m }}" data-live-lot-param="{{ l }}" aria-label="Supprimer le lot">&times;</button>
                    </div>
                {% endfor %}
                <button type="button" class="small" data-action="live#action" data-live-action-param="addLot" data-live-mission-param="{{ m }}">+ Lot</button>
            </div>
        {% endfor %}
        <div class="actions">
            <button type="button" data-action="live#action" data-live-action-param="addMission">+ Mission</button>
        </div>
        {% if error %}<p class="error" role="alert" data-testid="error">{{ error }}</p>{% endif %}
        <div class="actions">
            <button type="button" class="primary" data-action="live#action" data-live-action-param="calculate">Calculer le tour</button>
            <button type="button" class="reset" data-action="live#action" data-live-action-param="reset" data-testid="reset">Réinitialiser</button>
        </div>
    </section>
</div>
