{% import '_icons.html.twig' as icons %}
<li id="route-stop-{{ step }}" class="route-stop {{ stop.isDone ? 'route-stop--done' }} {{ movable ? 'route-stop--movable' }} {{ current ? 'route-stop--current' }} {{ isStart ? 'route-stop--start' }}" data-location="{{ stop.location }}"
    data-highlight-key="{{ step_token(step) }}" data-highlight-tokens="{{ step_token(step) }}" {% if current %}aria-current="step"{% endif %}>
    <div class="route-stop-head">
        {% if movable %}
            <button type="button" class="route-stop-handle" title="{{ 'route.stop.drag'|trans }}" aria-label="{{ 'route.stop.drag'|trans }} — {{ stop.location }}"
                    data-action="keydown->route-sortable#move">⠿</button>
        {% endif %}
        {% if stop.isDone %}
            <span class="route-stop-number route-stop-number--done" title="{{ 'route.stop.done'|trans }}">{{ icons.icon('check') }}<span class="visually-hidden">{{ 'route.stop.done'|trans }}</span></span>
        {% else %}
            <span class="route-stop-number {{ isStart ? 'route-stop-number--start' }}">{{ label }}</span>
        {% endif %}
        <strong class="route-stop-location">{{ stop.location }}</strong>
        {% if current %}<span class="badge route-stop-badge">{{ 'route.stop.current'|trans }}</span>{% endif %}
        {% if stop.load is not null %}
            {% set loadPercent = tour.capacity > 0 ? min(100, (stop.load * 100 / tour.capacity)|round) : 0 %}
            <small class="route-stop-load text-body-secondary text-nowrap" title="{{ 'route.stop.load'|trans }}">
                <span class="route-load-bar" aria-hidden="true"><span style="width: {{ loadPercent }}%"></span></span>
                {{ stop.load }}/{{ tour.capacity }} SCU
            </small>
        {% endif %}
    </div>
    {% for delivery in stop.deliveries %}
        <label class="route-action route-action--drop {{ delivery.isDelivered ? 'route-action--done' }}"
               data-highlight-key="{{ delivery_token(delivery.id) }}"
               data-highlight-tokens="{{ [delivery_token(delivery.id), mission_token(delivery.mission.id), resource_token(delivery.resource), step_token(step)]|join(' ') }}">
            <input type="checkbox" class="form-check-input me-1" id="delivery-done-{{ delivery.id }}" {{ delivery.isDelivered ? 'checked' }}
                   data-action="change->live#action" data-live-action-param="toggleDelivery" data-track="stop-toggle" data-track-on="change" data-track-props='{"kind":"drop"}' data-live-id-param="{{ delivery.id }}">
            <span class="route-action-icon" aria-hidden="true">↓</span> {{ 'route.stop.drop'|trans }}
            {{ include('components/_scu_badge.html.twig', {action: 'setDeliveryQuantity', kind: 'drop', delivery: delivery.id, value: delivery.effectiveQuantity, adjusted: delivery.hasActualQuantity,
                title: delivery.hasActualQuantity ? 'quantity.estimate'|trans({quantity: delivery.quantity}) : ''}, with_context = false) }}
            {{ include('_commodity_badge.html.twig', {name: delivery.resource}) }}
            <span class="text-body-secondary">· {{ tour.missionLabel(delivery.mission) }}</span>
        </label>
    {% endfor %}
    {% for mission in stop.pickups %}
        {% set pickedUp = mission.isPickedUpAt(stop.location) %}
        {% set split = mission.type.hasSeveralPickups %}
        {% set editable = mission.deliveries|length == 1 %}
        {% set recorded = mission.pickupQuantity(stop.location) %}
        {% set remaining = max(0, mission.totalQuantity - mission.pickupQuantitySum) %}
        {% set unrecorded = mission.pickups|filter(l => mission.pickupQuantity(l) is null)|length %}
        <label class="route-action route-action--pickup {{ pickedUp ? 'route-action--done' }}"
               data-highlight-key="{{ mission_token(mission.id) }}"
               data-highlight-tokens="{{ ([mission_token(mission.id), step_token(step)]|merge(mission.deliveries|map(d => delivery_token(d.id)))|merge(mission.deliveries|map(d => resource_token(d.resource))))|join(' ') }}">
            <input type="checkbox" class="form-check-input me-1" id="pickup-done-{{ mission.id }}-{{ stop.location|lower|replace({' ': '-'}) }}" {{ pickedUp ? 'checked' }}
                   data-action="change->live#action" data-live-action-param="togglePickup" data-track="stop-toggle" data-track-on="change" data-track-props='{"kind":"pickup"}'
                   data-live-mission-param="{{ mission.id }}" data-live-location-param="{{ stop.location }}">
            <span class="route-action-icon" aria-hidden="true">↑</span> {{ 'route.stop.pickup'|trans }} <span class="text-body-secondary">{{ tour.missionLabel(mission) }}</span>
            {% for delivery in mission.deliveries %}
                <span class="route-action-detail">
                    {% if editable %}
                        {{ include('components/_scu_badge.html.twig', {action: 'setPickupQuantity', kind: 'pickup', mission: mission.id, location: stop.location,
                            value: split ? recorded : (recorded ?? mission.effectiveQuantity), placeholder: split ? remaining : '',
                            adjusted: recorded is not null or delivery.hasActualQuantity,
                            title: split ? 'quantity.remaining'|trans({remaining: remaining, total: mission.totalQuantity}) : ''}, with_context = false) }}
                    {% else %}
                        {{ delivery.effectiveQuantity }} SCU
                    {% endif %}
                    {{ include('_commodity_badge.html.twig', {name: delivery.resource}) }} → {{ delivery.dropoff }}
                </span>
            {% endfor %}
            {% if mission.pickups|length > 1 %}
                <span class="route-action-detail small text-body-secondary">{{ 'route.stop.split_pickup'|trans({count: mission.pickups|length}) }}</span>
            {% endif %}
        </label>
        {% if split and unrecorded < mission.pickups|length %}
            {% if mission.pickupQuantitySum > mission.totalQuantity %}
                <div class="route-qty__warning" role="status">{{ 'quantity.warning.over'|trans({sum: mission.pickupQuantitySum, total: mission.totalQuantity}) }}</div>
            {% elseif unrecorded == 0 and mission.pickupQuantitySum < mission.totalQuantity %}
                <div class="route-qty__warning" role="status">{{ 'quantity.warning.under'|trans({sum: mission.pickupQuantitySum, total: mission.totalQuantity}) }}</div>
            {% endif %}
        {% endif %}
    {% endfor %}
</li>
