{% import '_icons.html.twig' as icons %}
<div {{ attributes.defaults({class: 'card sticky-xl-top cargo-panel route-panel'}) }}>
    <div class="card-header d-flex align-items-center gap-2" data-loading="delay(150)|addClass(is-loading)">
        <span class="step-badge" aria-hidden="true">3</span>
        <span>{{ 'route.title'|trans }}</span>
        <span class="spinner-border spinner-border-sm text-primary ms-auto route-panel-spinner" role="status"><span class="visually-hidden">{{ 'route.loading'|trans }}</span></span>
        <button type="button" class="btn btn-sm btn-outline-secondary route-report-open" data-bs-toggle="modal" data-bs-target="#route-report-modal-{{ tour.id }}"
                data-track="route-report-open" title="{{ 'report.open'|trans }}" aria-label="{{ 'report.open'|trans }}">{{ icons.icon('flag') }}</button>
    </div>
    <div data-live-ignore data-controller="route-report">
        <div class="modal fade route-report" id="route-report-modal-{{ tour.id }}" tabindex="-1" aria-labelledby="route-report-title-{{ tour.id }}" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form class="modal-content" novalidate>
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="route-report-title-{{ tour.id }}">{{ 'report.title'|trans }}</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'action.close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-body-secondary">{{ 'report.intro'|trans }}</p>
                        <label class="form-label" for="route-report-category-{{ tour.id }}">{{ 'report.category.label'|trans }}</label>
                        <select class="form-select mb-3" id="route-report-category-{{ tour.id }}" data-report="category">
                            {% for category in enum_cases('App\\Entity\\ReportCategory') %}
                                <option value="{{ category.value }}">{{ category.label|trans }}</option>
                            {% endfor %}
                        </select>
                        {% set maxLength = constant('App\\Service\\Report\\RouteReporter::MAX_MESSAGE_LENGTH') %}
                        <label class="form-label" for="route-report-message-{{ tour.id }}">{{ 'report.message.label'|trans }}</label>
                        <textarea class="form-control" id="route-report-message-{{ tour.id }}" rows="5" maxlength="{{ maxLength }}" required placeholder="{{ 'report.message.placeholder'|trans }}"
                                  data-report="message"></textarea>
                        <div class="d-flex justify-content-between small text-body-secondary mt-1">
                            <span>{{ 'report.snapshot_hint'|trans }}</span>
                            <span><span data-report="counter">0</span>/{{ maxLength }}</span>
                        </div>
                        <div class="invalid-feedback d-block" data-report="error" role="alert" hidden>{{ 'report.error.empty'|trans }}</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'action.cancel'|trans }}</button>
                        <button type="submit" class="btn btn-primary" data-report="submit">{{ 'report.send'|trans }}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="card-body route-panel-body" data-loading="delay(150)|addClass(is-busy)">
        {% set route = computed.route %}
        {% set cargo = this.cargoView %}
        {% set locked = route is not null and route.started %}
        {% set currentStop = route is not null and tour.missions is not empty and not route.isFinished ? route.stops|slice(cargo.currentStep, 1)|first : null %}
        {% if currentStop %}
            <a class="route-now" href="#route-stop-{{ cargo.currentStep }}" data-controller="route-now" data-action="route-now#jump">
                <span class="badge route-stop-badge">{{ 'route.stop.current'|trans }}</span>
                <strong class="route-now__label">{{ currentStop.location }}</strong>
                {% if currentStop.load is not null %}<span class="route-now__load text-body-secondary">{{ currentStop.load }}/{{ tour.capacity }} SCU</span>{% endif %}
            </a>
        {% endif %}
        <div class="btn-group w-100 mb-2" role="group" aria-label="{{ 'route.mode.aria'|trans }}">
            {% for routeMode in enum_cases('App\\Service\\Route\\RouteMode') %}
                <input type="radio" class="btn-check" name="route-mode" id="route-mode-{{ routeMode.value }}" value="{{ routeMode.value }}"
                       data-model="mode" data-track="route-mode" data-track-on="change" data-track-props='{"mode":"{{ routeMode.value }}"}' {{ mode == routeMode ? 'checked' }} {{ locked ? 'disabled' }}>
                <label class="btn btn-sm btn-outline-primary" for="route-mode-{{ routeMode.value }}">{{ routeMode.label|trans }}</label>
            {% endfor %}
        </div>
        <p class="small text-body-secondary">{% if locked %}🔒 {% endif %}{{ (locked ? 'route.locked' : mode.description)|trans }}</p>

        <div hidden data-controller="cargo-plan" data-cargo-plan-plan-value="{{ cargo|json_encode }}"></div>
        {% if cargo.stacked > 0 %}
            <div class="alert alert-warning py-2 small">{{ 'cargo.warning.stacked'|trans({count: cargo.stacked}) }}</div>
        {% endif %}
        {% if cargo.unplaced > 0 %}
            <div class="alert alert-warning py-2 small">{{ 'cargo.warning.unplaced'|trans({quantity: cargo.unplaced}) }}</div>
        {% endif %}
        {% if route is null %}
            <div class="alert alert-danger mb-0 d-flex gap-2" role="alert">{{ icons.icon('warning', 'flex-shrink-0 mt-1') }}<span>{{ this.error|trans }}</span></div>
        {% elseif tour.missions is empty %}
            <div class="hm-empty">
                <div class="hm-empty-icon">{{ icons.icon('list') }}</div>
                <strong>{{ 'route.no_missions'|trans }}</strong>
                <div class="small text-body-secondary">{{ 'route.empty_hint'|trans }}</div>
            </div>
        {% else %}
            {% if route.isFinished %}
                <div class="alert alert-success py-2 route-finished" role="status">{{ icons.icon('success', 'me-1') }} {{ 'route.finished'|trans }}</div>
            {% endif %}
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span><strong>{{ 'route.stop_count'|trans({count: route.moveCount}) }}</strong>
                    {% if route.start is null %}<small class="text-body-secondary">— {{ 'route.no_start'|trans }}</small>{% endif %}</span>
                {% if route.customOrder %}
                    <button type="button" class="btn btn-sm btn-link p-0" data-action="live#action" data-live-action-param="resetOrder" data-track="route-reset-order">↺ {{ 'route.reset_order'|trans }}</button>
                {% endif %}
            </div>
            <div class="route-legend small text-body-secondary mb-2" aria-hidden="true">
                <span class="route-legend-item route-legend-item--pickup">{{ 'route.legend.pickup'|trans }}</span>
                <span class="route-legend-item route-legend-item--drop">{{ 'route.legend.drop'|trans }}</span>
            </div>
            <p class="small text-body-secondary mb-2">{{ 'route.reorder_help'|trans }}</p>
            <ol class="route list-unstyled mb-0" data-controller="route-sortable" aria-label="{{ 'route.title'|trans }}">
                {% for stop in route.stops %}
                    {% set isStart = loop.first and route.start is not null %}
                    {{ include('components/_route_stop.html.twig', {
                        isStart: isStart,
                        label: isStart ? 'route.start'|trans : (route.start is null ? loop.index : loop.index0),
                        movable: not isStart and not stop.isDone,
                        step: loop.index0,
                        current: loop.index0 == cargo.currentStep and not route.isFinished,
                    }) }}
                {% endfor %}
            </ol>
        {% endif %}
    </div>
</div>
