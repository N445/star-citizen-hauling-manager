<div {{ attributes }} class="stepper">
{% if not this.hasPlan %}
    <section class="panel empty">
        <h2>Tour</h2>
        <p class="muted">Renseigne tes missions puis lance « Calculer le tour » : les arrêts et la soute apparaîtront ici.</p>
    </section>
{% else %}
    {% set plan = this.plan %}
    {% set stops = plan.route.stops %}
    {% set i = this.currentStep %}
    {% set stop = stops[i] %}
    <section class="panel">
        <h2>Tour &middot; {{ stops|length }} arrêt(s)</h2>
        <ol class="route-list">
            {% for k, s in stops %}
                <li class="{{ k == i ? 'current' }} {{ k < i ? 'done' }}">
                    <a href="#" style="color:inherit;text-decoration:none" data-action="live#action:prevent" data-live-action-param="goTo" data-live-index-param="{{ k }}">{{ k + 1 }}. {{ s.location.name }}</a>
                </li>
            {% endfor %}
        </ol>

        <div class="stepper-nav">
            <button type="button" data-action="live#action" data-live-action-param="previous" {{ i <= 0 ? 'disabled' }}>&larr; Précédent</button>
            <strong>Arrêt {{ i + 1 }} / {{ stops|length }}</strong>
            <button type="button" data-action="live#action" data-live-action-param="next" {{ i >= stops|length - 1 ? 'disabled' }}>Suivant &rarr;</button>
        </div>
        <div class="progress"><div style="width: {{ ((i + 1) / stops|length * 100)|round }}%"></div></div>

        <div class="stop-title">{{ stop.location.name }} <small>{{ stop.location.body ?? stop.location.planet }} &middot; soute {{ this.load }}/{{ plan.placement.ship.capacity }} SCU</small></div>
        {% if this.nextTravel %}<p class="muted">Trajet suivant <span class="tier" data-testid="tier">{{ this.nextTravel }}</span></p>{% endif %}

        {% for g in this.missionActions %}
            <div class="mission-actions" style="--m: {{ g.color }}" data-testid="mission-actions">
                <h3>{{ g.label }} <span class="type-badge" data-testid="mission-type-label">{{ g.type }}</span></h3>
                {% for a in g.pickups %}
                    <div class="act"><span class="tag pickup">Récupère</span> {{ a.sizes|length }} caisse(s) de {{ a.resource }} ({{ a.sizes|join(' + ') }} = {{ a.scu }} SCU) &rarr; {{ a.target ?: 'reste à bord' }}</div>
                {% endfor %}
                {% for a in g.drops %}
                    <div class="act"><span class="tag drop">Livre</span> {{ a.sizes|length }} caisse(s) de {{ a.resource }} ({{ a.sizes|join(' + ') }} = {{ a.scu }} SCU)</div>
                {% endfor %}
            </div>
        {% endfor %}
    </section>

    <section class="panel">
        <h2>Soute &middot; {{ plan.placement.ship.label }}</h2>
        <div class="door-picker" role="group" aria-label="Côté de la porte">
            <span class="muted">Porte</span>
            {% for side, label in {rear: 'Arrière', front: 'Avant', left: 'Gauche', right: 'Droite'} %}
                <button type="button" class="small {{ this.currentDoor == side ? 'on' }}" data-testid="door-{{ side }}" data-action="live#action" data-live-action-param="changeDoor" data-live-door-param="{{ side }}">{{ label }}</button>
            {% endfor %}
        </div>
        {% if plan.placement.ignoredPins|length %}
            <p class="warn" data-testid="ignored-pins">Placement manuel ignoré pour {{ plan.placement.ignoredPins|length }} caisse(s) : {{ plan.placement.ignoredPins|join(', ') }}.</p>
        {% endif %}
        {% if this.notice %}<p class="error" role="alert" data-testid="notice">{{ this.notice }}</p>{% endif %}
        <twig:CargoGrid
            :ship="plan.placement.ship"
            :crates="this.gridCrates"
            :pickupIds="this.pickupIds"
            :dropIds="this.dropIds"
            :missions="plan.missions"
            :layer="this.layer"
            :pins="this.pins"
        />
        <p class="muted hint">Glisse une caisse pour la déplacer (touche R ou bouton pour la pivoter) : le déplacement vaut pour tout son séjour à bord.</p>
        {% if this.pins|length %}
            <div class="pins" data-testid="pins">
                <strong>Caisses déplacées</strong>
                {% for id, pin in this.pins %}
                    <span class="pin">{{ id }} <button type="button" class="small" data-action="live#action" data-live-action-param="unpin" data-live-crate-param="{{ id }}">Annuler le déplacement</button></span>
                {% endfor %}
                <button type="button" class="small" data-testid="clear-pins" data-action="live#action" data-live-action-param="clearPins">Réinitialiser le placement automatique</button>
            </div>
        {% endif %}
    </section>
{% endif %}
</div>
